---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Startseite" description="Creating Value Together, Institut für Innovation, Führung und Zusammenarbeit. Gemeinsam Brücken bauen zwischen Verwaltung, Wirtschaft und Wissenschaft.">

  <!-- ========== HERO ========== -->
  <section class="hero" id="hero">
    <div class="hero__bg">
      <img src="/images/hero.jpg" alt="" class="hero__bg-img" />
      <div class="hero__overlay"></div>
    </div>

    <div class="hero__content container">
      <div class="hero__badge animate-fade-in-up">Institut für Innovation, Führung & Zusammenarbeit</div>
      <h1 class="hero__title animate-fade-in-up animate-delay-1">
        Gemeinsam<br><span class="hero__highlight">(Mehr-) Wert</span> schaffen
      </h1>
      <p class="hero__subtitle animate-fade-in-up animate-delay-2">
        Wir bringen Verwaltung, Wirtschaft und Wissenschaft zusammen, um durch Dialog und Forschung nachhaltige Innovationen zu schaffen.
      </p>
      <div class="hero__actions animate-fade-in-up animate-delay-3">
        <a href="/ueber-uns" class="btn btn--primary btn--lg">Mehr erfahren</a>
        <a href="/kontakt" class="btn btn--outline btn--lg">Kontakt aufnehmen</a>
      </div>

      <div class="hero__stats animate-fade-in-up animate-delay-5">
        <div class="hero__stat">
          <span class="hero__stat-number">3</span>
          <span class="hero__stat-label">Sektoren verbunden</span>
        </div>
        <div class="hero__stat-divider"></div>
        <div class="hero__stat">
          <span class="hero__stat-number">9</span>
          <span class="hero__stat-label">Themenbereiche</span>
        </div>
        <div class="hero__stat-divider"></div>
        <div class="hero__stat">
          <span class="hero__stat-number">5</span>
          <span class="hero__stat-label">Dialogformate</span>
        </div>
      </div>
    </div>
    <div class="hero__scroll-indicator">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
    </div>
  </section>

  <!-- ========== PROBLEM ========== -->
  <section class="section section--alt" id="problem">
    <div class="container">
      <div class="section-header" data-reveal>
        <h2>Hintergrund & Zielsetzung</h2>
        <p>Die aktuellen Herausforderungen verlangen nach neuen Wegen der Zusammenarbeit</p>
      </div>

      <div class="problem-flow" data-reveal>
        <div class="problem-flow__item">
          <div class="problem-flow__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <h3>Zunehmende Regulierungen</h3>
          <p>Stagnierende Wirtschaft und knappe Kassen erhöhen den Druck auf alle Sektoren</p>
        </div>

        <div class="problem-flow__arrow">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
        </div>

        <div class="problem-flow__item">
          <div class="problem-flow__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Mangelnder Dialog</h3>
          <p>Zwischen Wirtschaft und Verwaltung fehlen strukturierte Kommunikationswege</p>
        </div>

        <div class="problem-flow__arrow">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
        </div>

        <div class="problem-flow__item">
          <div class="problem-flow__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          </div>
          <h3>Keine konstruktive Zusammenarbeit</h3>
          <p>Innovationen scheitern an fehlenden Strukturen für sektorübergreifende Kooperation</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== VISION ========== -->
  <section class="section" id="vision">
    <div class="container">
      <div class="section-header" data-reveal>
        <h2>Gemeinsam (Mehr-) Wert schaffen</h2>
        <p>Unsere drei Säulen für nachhaltige Innovation und Zusammenarbeit</p>
      </div>

      <div class="vision-grid" data-reveal>
        <div class="vision-card">
          <div class="vision-card__icon-wrap">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="vision-card__label">Strukturen</div>
          <h3>Dialog ermöglichen</h3>
          <p>Strukturen in Wirtschaft, Verwaltung und drittem Sektor schaffen, die einen Dialog ermöglichen und konstruktive Zusammenarbeit fördern.</p>
        </div>

        <div class="vision-card vision-card--featured">
          <div class="vision-card__icon-wrap">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <div class="vision-card__label">Wertschöpfung</div>
          <h3>(Mehr-) Wert und Innovation</h3>
          <p>Schaffung von Wert und Innovationen unter Berücksichtigung der Bedürfnisse und der Expertise der Betroffenen (Stakeholder).</p>
        </div>

        <div class="vision-card">
          <div class="vision-card__icon-wrap">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <div class="vision-card__label">Führung</div>
          <h3>Führungskräfte vernetzen</h3>
          <p>Führungskräfte aus Politik, Wirtschaft und Verwaltung befähigen, den Rahmen für gemeinsame Innovationen zu schaffen.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== TOPICS PREVIEW ========== -->
  <section class="section section--dark" id="topics-preview">
    <div class="container">
      <div class="section-header" data-reveal>
        <h2>Themenbereiche</h2>
        <p>Unsere Forschungs- und Arbeitsfelder für die Zukunft der Zusammenarbeit</p>
      </div>

      <div class="topics-hex-grid" data-reveal>
        <div class="topic-hex">
          <div class="topic-hex__inner">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <h4>Innovativ Führen</h4>
            <p>Mixed Groups aus Verwaltung und Unternehmen</p>
          </div>
        </div>
        <div class="topic-hex">
          <div class="topic-hex__inner">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            <h4>Innovationen</h4>
            <p>Nachhaltiger Aufbau von Innovationsfähigkeit</p>
          </div>
        </div>
        <div class="topic-hex">
          <div class="topic-hex__inner">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <h4>Cybersicherheit</h4>
            <p>Netzwerk kompetenter Partner für Resilienz</p>
          </div>
        </div>
        <div class="topic-hex">
          <div class="topic-hex__inner">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            <h4>Agile Organisationen</h4>
            <p>Transformation hierarchischer Strukturen</p>
          </div>
        </div>
        <div class="topic-hex">
          <div class="topic-hex__inner">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <h4>Future of Work</h4>
            <p>Neue Arbeitszeitmodelle und Führung im Job-Share</p>
          </div>
        </div>
        <div class="topic-hex">
          <div class="topic-hex__inner">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <h4>Chancengleichheit</h4>
            <p>Aufbau von Netzwerken zur Schaffung von Chancengleichheit</p>
          </div>
        </div>
      </div>

      <div class="topics-cta" data-reveal>
        <a href="/themenbereiche" class="btn btn--outline btn--lg">Alle Themenbereiche ansehen →</a>
      </div>
    </div>
  </section>

  <!-- ========== QUOTE ========== -->
  <section class="section quote-section" id="quote">
    <!-- Decorative horse in quote section -->
    <div class="quote-horse" aria-hidden="true">
      <img src="/images/horse-silhouette.png" alt="" />
    </div>
    <div class="container container--narrow">
      <blockquote class="quote-block" data-reveal>
        <div class="quote-block__mark">"</div>
        <p class="quote-block__text">Wir müssen mehr Köpfe zum Denken bringen</p>
        <footer class="quote-block__author">
          <cite>Reinhard Mohn</cite>
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- ========== FORMATS PREVIEW ========== -->
  <section class="section section--alt" id="formats-preview">
    <div class="container">
      <div class="section-header" data-reveal>
        <h2>Unsere Formate</h2>
        <p>Vielfältige Plattformen für Austausch, Dialog und gemeinsame Innovation</p>
      </div>

      <div class="formats-grid" data-reveal>
        <div class="format-bubble">
          <div class="format-bubble__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <h4>Plattformen</h4>
          <p>Digitale und physische Räume für sektorübergreifenden Dialog</p>
        </div>
        <div class="format-bubble">
          <div class="format-bubble__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 1 1 7.072 0l-.548.547A3.374 3.374 0 0 0 14 18.469V19a2 2 0 1 1-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          </div>
          <h4>Think-Tanks & Do-Tanks</h4>
          <p>Denk- und Handlungswerkstätten für innovative Lösungsansätze</p>
        </div>
        <div class="format-bubble">
          <div class="format-bubble__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h4>Kamin-Gespräche</h4>
          <p>Vertrauliche Gesprächsrunden für Führungskräfte aus allen Sektoren</p>
        </div>
        <div class="format-bubble">
          <div class="format-bubble__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h4>Symposien & Konferenzen</h4>
          <p>Großveranstaltungen für Wissenstransfer und Netzwerkbildung</p>
        </div>
        <div class="format-bubble">
          <div class="format-bubble__icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <h4>Internationale Kolloquien</h4>
          <p>Forschungskolloquien mit internationaler Beteiligung</p>
        </div>
      </div>

      <div class="formats-cta" data-reveal>
        <a href="/formate" class="btn btn--outline-dark btn--lg">Alle Formate entdecken →</a>
      </div>
    </div>
  </section>

  <!-- ========== CTA ========== -->
  <section class="section cta-section" id="cta">
    <div class="container container--narrow">
      <div class="cta-card" data-reveal>
        <h2>Werden Sie Teil des Dialogs</h2>
        <p>Gestalten Sie gemeinsam mit uns die Zukunft der Zusammenarbeit zwischen Verwaltung, Wirtschaft und Wissenschaft.</p>
        <div class="cta-card__actions">
          <a href="/kontakt" class="btn btn--primary btn--lg">Jetzt Kontakt aufnehmen</a>
          <a href="/forschung" class="btn btn--outline btn--lg">Forschung entdecken</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ===== HERO ===== */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(2px);
    transform: scale(1.02);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--gradient-hero-overlay);
  }



  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding-top: var(--nav-height);
    max-width: 800px;
  }

  .hero__badge {
    display: inline-block;
    padding: var(--space-2) var(--space-5);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    color: var(--gray-200);
    font-size: var(--text-sm);
    font-weight: 500;
    margin-bottom: var(--space-8);
    backdrop-filter: blur(10px);
  }

  .hero__title {
    color: var(--white);
    font-size: var(--text-7xl);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .hero__highlight {
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__subtitle {
    font-size: var(--text-xl);
    color: var(--gray-200);
    line-height: 1.6;
    margin-bottom: var(--space-10);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-16);
  }

  .hero__stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    padding: var(--space-6) var(--space-8);
    background: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-2xl);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__stat-number {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--white);
  }

  .hero__stat-label {
    font-size: var(--text-xs);
    color: var(--gray-300);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero__stat-divider {
    width: 1px;
    height: 40px;
    background: rgba(255, 255, 255, 0.2);
  }

  .hero__scroll-indicator {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.5);
    animation: float 2s ease-in-out infinite;
    z-index: 2;
  }

  /* ===== PROBLEM FLOW ===== */
  .problem-flow {
    display: flex;
    align-items: stretch;
    gap: var(--space-4);
    max-width: 1000px;
    margin: 0 auto;
  }

  .problem-flow__item {
    flex: 1;
    background: var(--white);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    text-align: center;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-light);
    transition: all var(--transition-base);
  }

  .problem-flow__item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
    border-color: var(--steel-blue-light);
  }

  .problem-flow__icon {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-lg);
    background: rgba(107, 143, 158, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-4);
    color: var(--steel-blue);
  }

  .problem-flow__arrow {
    display: flex;
    align-items: center;
    color: var(--steel-blue);
    transform: rotate(0deg);
    flex-shrink: 0;
  }

  .problem-flow__item h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .problem-flow__item p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: 0;
  }

  /* ===== VISION ===== */
  .vision-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  .vision-card {
    background: var(--white);
    border-radius: var(--radius-xl);
    padding: var(--space-10);
    text-align: center;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-light);
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .vision-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--gradient-brand);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .vision-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-xl);
  }

  .vision-card:hover::before {
    opacity: 1;
  }

  .vision-card--featured {
    border-color: var(--steel-blue-light);
    box-shadow: var(--shadow-lg);
  }

  .vision-card--featured::before {
    opacity: 1;
  }

  .vision-card__icon-wrap {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-xl);
    background: rgba(107, 143, 158, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-5);
    color: var(--dark-teal);
    transition: all var(--transition-base);
  }

  .vision-card:hover .vision-card__icon-wrap {
    background: var(--dark-teal);
    color: var(--white);
  }

  .vision-card__label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--steel-blue);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-2);
  }

  .vision-card h3 {
    font-size: var(--text-xl);
