---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Forschung" description="Wissenschaftliche Forschung des CVT Instituts: Studien zur Zusammenarbeit zwischen Verwaltung, Wirtschaft und Wissenschaft.">

  <section class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <div class="page-hero__badge animate-fade-in-up">Forschung</div>
        <h1 class="animate-fade-in-up animate-delay-1">Wissenschaftliche Grundlage</h1>
        <p class="page-hero__sub animate-fade-in-up animate-delay-2">
          Evidenzbasierte Forschung für bessere Zusammenarbeit zwischen den Sektoren
        </p>
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section" id="approach">
    <div class="container">
      <div class="research-intro" data-reveal>
        <div class="research-intro__text">
          <div class="section-label">Unser Forschungsansatz</div>
          <h2>Wissenschaft trifft Praxis</h2>
          <p>
            Als gemeinnütziges Forschungsinstitut verbinden wir akademische Rigorosität mit praktischer Relevanz. Unsere Studien untersuchen, wie die Zusammenarbeit zwischen öffentlicher Verwaltung, privater Wirtschaft und dem dritten Sektor verbessert werden kann.
          </p>
          <p>
            Wir glauben, dass nachhaltige Veränderungen nur auf der Grundlage solider wissenschaftlicher Erkenntnisse gelingen. Deshalb bildet Forschung das Fundament aller unserer Aktivitäten.
          </p>
        </div>
        <div class="research-intro__image">
          <img src="/images/research.jpg" alt="Forschung am CVT Institut" />
        </div>
      </div>
    </div>
  </section>

  <!-- Research Areas -->
  <section class="section section--alt" id="areas">
    <div class="container">
      <div class="section-header" data-reveal>
        <h2>Forschungsschwerpunkte</h2>
        <p>Unsere wissenschaftlichen Studien konzentrieren sich auf diese Kernbereiche</p>
      </div>

      <div class="research-areas" data-reveal>
        <div class="research-area">
          <div class="research-area__header">
            <div class="research-area__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3>Sektorübergreifende Zusammenarbeit</h3>
          </div>
          <p>Analyse der Barrieren und Erfolgsfaktoren für die Kooperation zwischen Verwaltung und Privatwirtschaft. Identifikation von Best Practices und Entwicklung von Handlungsempfehlungen.</p>
          <div class="research-area__tags">
            <span>Public-Private Partnership</span>
            <span>Governance</span>
            <span>Stakeholder-Management</span>
          </div>
        </div>

        <div class="research-area">
          <div class="research-area__header">
            <div class="research-area__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <h3>Innovationskultur & Führung</h3>
          </div>
          <p>Erforschung moderner Führungsmodelle, die Innovation in komplexen Organisationen fördern. Untersuchung von Führung im Job-Share und agilen Führungspraktiken.</p>
          <div class="research-area__tags">
            <span>Leadership</span>
            <span>Innovation</span>
            <span>Organisationsentwicklung</span>
          </div>
        </div>

        <div class="research-area">
          <div class="research-area__header">
            <div class="research-area__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>Digitalisierung & Cybersicherheit</h3>
          </div>
          <p>Studien zur digitalen Transformation in Verwaltung und Wirtschaft, mit besonderem Fokus auf Cybersicherheit und die Schaffung resilienter Strukturen.</p>
          <div class="research-area__tags">
            <span>Digital Transformation</span>
            <span>Cyber-Resilienz</span>
            <span>E-Government</span>
          </div>
        </div>

        <div class="research-area">
          <div class="research-area__header">
            <div class="research-area__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3>Zukunft der Arbeit</h3>
          </div>
          <p>Analyse neuer Arbeitszeitmodelle und Organisationsformen. Erforschung von Chancengleichheit und gleichberechtigter Teilhabe in beiden Sektoren.</p>
          <div class="research-area__tags">
            <span>Future of Work</span>
            <span>Diversity & Inclusion</span>
            <span>Neue Arbeitswelten</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Methodology -->
  <section class="section" id="methodology">
    <div class="container">
      <div class="section-header" data-reveal>
        <h2>Methodischer Ansatz</h2>
        <p>Unser wissenschaftliches Vorgehen folgt höchsten akademischen Standards</p>
      </div>

      <div class="methodology-steps" data-reveal>
        <div class="method-step">
          <div class="method-step__num">01</div>
          <h3>Bestandsaufnahme</h3>
          <p>Systematische Analyse des aktuellen Forschungsstands und Identifikation von Forschungslücken.</p>
        </div>
        <div class="method-step__connector"></div>
        <div class="method-step">
          <div class="method-step__num">02</div>
          <h3>Empirische Erhebung</h3>
          <p>Qualitative und quantitative Datenerhebung bei Akteuren aus allen drei Sektoren.</p>
        </div>
        <div class="method-step__connector"></div>
        <div class="method-step">
          <div class="method-step__num">03</div>
          <h3>Analyse & Synthese</h3>
          <p>Wissenschaftliche Auswertung der Daten und Ableitung evidenzbasierter Erkenntnisse.</p>
        </div>
        <div class="method-step__connector"></div>
        <div class="method-step">
          <div class="method-step__num">04</div>
          <h3>Transfer & Impact</h3>
          <p>Übertragung der Ergebnisse in die Praxis durch Publikationen, Workshops und Beratung.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--accent" id="research-cta">
    <div class="container container--narrow">
      <div class="research-cta" data-reveal>
        <h2>Forschungskooperation</h2>
        <p>Sind Sie interessiert an einer wissenschaftlichen Zusammenarbeit oder möchten Sie unsere Forschung unterstützen?</p>
        <a href="/kontakt" class="btn btn--outline btn--lg">Sprechen Sie uns an →</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding: calc(var(--nav-height) + var(--space-16)) 0 var(--space-16);
    background: var(--gradient-dark); text-align: center;
  }
  .page-hero__content { max-width: 700px; margin: 0 auto; }
  .page-hero__badge {
    display: inline-block; padding: var(--space-1) var(--space-4);
    background: rgba(107,143,158,0.2); color: var(--steel-blue-light);
    font-size: var(--text-sm); font-weight: 500; border-radius: var(--radius-full); margin-bottom: var(--space-6);
  }
  .page-hero h1 { color: var(--white); font-size: var(--text-5xl); margin-bottom: var(--space-4); }
  .page-hero__sub { font-size: var(--text-xl); color: var(--gray-300); margin-bottom: 0; }

  .section-label {
    font-size: var(--text-sm); font-weight: 600; color: var(--steel-blue);
    text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: var(--space-3);
  }

  /* Research intro */
  .research-intro {
    display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-16); align-items: center;
  }
  .research-intro__text h2 { margin-bottom: var(--space-6); }
  .research-intro__text p { font-size: var(--text-lg); line-height: 1.8; }
  .research-intro__image img { border-radius: var(--radius-2xl); box-shadow: var(--shadow-xl); width: 100%; }

  /* Research areas */
  .research-areas {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-8);
  }

  .research-area {
    background: var(--white); border-radius: var(--radius-xl); padding: var(--space-8);
    border: 1px solid var(--border-light); box-shadow: var(--shadow-md);
    transition: all var(--transition-base);
  }
  .research-area:hover {
    transform: translateY(-4px); box-shadow: var(--shadow-xl); border-color: var(--steel-blue-light);
  }

  .research-area__header {
    display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-4);
  }

  .research-area__icon {
    width: 52px; height: 52px; border-radius: var(--radius-lg);
    background: rgba(107,143,158,0.1); display: flex; align-items: center; justify-content: center;
    color: var(--dark-teal); flex-shrink: 0;
  }

  .research-area h3 { font-size: var(--text-lg); }
  .research-area p { font-size: var(--text-sm); line-height: 1.7; }

  .research-area__tags {
    display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4);
  }
  .research-area__tags span {
    padding: var(--space-1) var(--space-3); background: rgba(107,143,158,0.08);
    color: var(--dark-teal); font-size: var(--text-xs); font-weight: 500;
    border-radius: var(--radius-full);
  }

  /* Methodology */
  .methodology-steps {
    display: flex; align-items: flex-start; gap: 0; max-width: 1000px; margin: 0 auto;
  }

  .method-step {
    flex: 1; text-align: center; padding: var(--space-6);
  }

  .method-step__num {
    font-family: var(--font-heading); font-size: var(--text-3xl); font-weight: 800;
    color: var(--steel-blue); opacity: 0.3; margin-bottom: var(--space-3);
  }

  .method-step h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .method-step p { font-size: var(--text-sm); margin-bottom: 0; }

  .method-step__connector {
    width: 60px; height: 2px; background: var(--border-light); flex-shrink: 0;
    margin-top: 3.5rem;
  }

  /* CTA */
  .research-cta { text-align: center; padding: var(--space-8); }
  .research-cta h2 { color: var(--white); margin-bottom: var(--space-4); }
  .research-cta p { color: rgba(255,255,255,0.85); font-size: var(--text-lg); margin-bottom: var(--space-8); }

  @media (max-width: 768px) {
    .page-hero h1 { font-size: var(--text-3xl); }
    .research-intro { grid-template-columns: 1fr; }
    .research-areas { grid-template-columns: 1fr; }
    .methodology-steps { flex-direction: column; align-items: center; }
    .method-step__connector { width: 2px; height: 30px; margin: 0; }
  }
</style>
